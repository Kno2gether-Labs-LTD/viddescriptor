# Copy to .env for local dev (`npm run dev`) or set these as build-time
# environment variables in your deploy pipeline before `npm run build`.
#
# Every VITE_* var below is public (bundled into client JS) and has a
# premium Viddescriptor default baked into src/config.ts — nothing here is
# required to run the default deployment. Set only what you want to
# override for your own white-label brand.
#
# See README.md's "Configuration reference" section for the full config
# surface, and .dev.vars.example for the Worker-only secrets section below.

# ---------------------------------------------------------------------------
# Brand
# ---------------------------------------------------------------------------

# Wordmark, <title>, copy substitutions. Default: Viddescriptor
VITE_BRAND_NAME=

# Two comma-separated parts used to render the split-color wordmark
# (e.g. "VID" in accent + "DESCRIPTOR" in ink). Must be exactly two
# non-empty parts or the default is used. Default: VID,DESCRIPTOR
VITE_BRAND_ACCENT_SPLIT=

# Hero subtitle / one-line pitch. Default: a premium Viddescriptor line.
VITE_TAGLINE=

# Optional logo image URL; falls back to the text wordmark when unset.
VITE_LOGO_URL=

# Hero headline — three stacked lines (Anton display type), one accent word
# or phrase highlighted in amber wherever it first appears (case-insensitive
# match) across the three lines, and the subhead paragraph beneath. Line 3
# is also the one that plays the hero's typing animation.
# Defaults: "Describe your film." / "Get it back" / "in minutes." with
# accent "film" and a matching subtext line.
VITE_HERO_LINE1=
VITE_HERO_LINE2=
VITE_HERO_LINE3=
VITE_HERO_ACCENT=
VITE_HERO_SUBTEXT=

# ---------------------------------------------------------------------------
# Links & contact
# ---------------------------------------------------------------------------

# Canonical URL; used to build success/cancel redirect URLs.
# Default: https://viddescriptor.kno2gether.com
VITE_SITE_URL=

# Footer + error-state contact address. Default: support@kno2gether.com
VITE_SUPPORT_EMAIL=

# White-label portal base URL; the post-signup "log in" CTA links to
# {VITE_PORTAL_URL}/login. PLACEHOLDER by default — set this to your real
# Knotie white-label portal subdomain before going live.
# Default: https://viddescriptor.kno2gether.com (placeholder)
VITE_PORTAL_URL=

# Open-source repo backlink. PLACEHOLDER — point this at your own fork.
# Default: https://github.com/Kno2gether-Labs-LTD/viddescriptor
VITE_GITHUB_URL=

# JSON array of extra social links rendered in the footer, e.g.
# '[{"label":"X","href":"https://x.com/viddescriptor"}]'. Default: []
VITE_SOCIALS_JSON=

# Secondary "learn to sell this" CTA link rendered under the GitHub button.
# Set to an empty string to hide it entirely.
# Default: https://www.skool.com/voice-ai-mastery-5847 (the AI Reseller Club)
VITE_RESELLER_CLUB_URL=

# ---------------------------------------------------------------------------
# Credits & the $9 upsell offer
# ---------------------------------------------------------------------------

# Free credits granted on signup (also used as the onboarding grant amount
# sent to the partner API by the Worker — keep in sync with the Worker's
# FREE_CREDITS var below). Default: 300
VITE_FREE_CREDITS=

# Upsell offer — SINGLE SOURCE for both the page copy AND the Worker's mint
# values. `scripts/deploy.sh` (run via `npm run deploy` / `npm run
# deploy:prod`) forwards these three as `wrangler deploy --var` overrides
# (UPSELL_AMOUNT_CENTS/UPSELL_CURRENCY/UPSELL_CREDITS), so setting them here
# is the ONLY thing you need to change the offer — no editing wrangler.jsonc.
# The Worker vars baked into wrangler.jsonc are just fallback defaults used
# when a var below is left unset.
#
# Price in integer cents (e.g. 900 = $9.00, 950 = €9.50). Default: 900
VITE_UPSELL_AMOUNT_CENTS=
# ISO 4217 currency code. Default: usd
VITE_UPSELL_CURRENCY=
# Credits granted by the one-time top-up. <= 0 skips the upsell step
# entirely. Default: 500
VITE_UPSELL_CREDITS=

# Optional overrides — win over the derived amountLabel ("$9", "€9.50", ...)
# and fromTo ("300 → 800") copy above when set. Leave unset to let the page
# compute them from VITE_UPSELL_AMOUNT_CENTS/CURRENCY/CREDITS and
# VITE_FREE_CREDITS.
VITE_UPSELL_AMOUNT_LABEL=
VITE_UPSELL_FROM_TO=

# ISO 8601 date/time. When unset, all countdown/urgency UI stays hidden —
# no fabricated urgency ships by default. Default: unset
VITE_OFFER_ENDS_AT=

# Top-bar + sticky-CTA banner line. `{freeCredits}` is interpolated with the
# resolved VITE_FREE_CREDITS value. No implied "launch week" event ships by
# default — just the real free-credit offer.
# Default: OPEN SOURCE · {freeCredits} FREE CREDITS ON SIGNUP
VITE_BANNER_TEXT=

# ---------------------------------------------------------------------------
# Pricing
# ---------------------------------------------------------------------------

# Optional JSON blob that fully replaces the default pay-as-you-go + plan
# pricing cards: {"payg":[{"kicker","price","per?","lines":[...],"cta","featured?"}],"plans":[...]}
# Invalid JSON is ignored and the built-in Viddescriptor pricing is used
# instead — this never throws.
VITE_PRICING_JSON=

# ---------------------------------------------------------------------------
# Bot protection (Cloudflare Turnstile) — entirely optional
# ---------------------------------------------------------------------------

# Public Turnstile sitekey. Unset (default) = the CAPTCHA widget never
# renders and the Worker's api.js request never fires — the signup form
# behaves exactly as it does without this section. Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile, managed mode.
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Social proof
# ---------------------------------------------------------------------------

# Testimonial cards render only when explicitly enabled with real,
# owner-supplied quotes — never fabricated. Default: false
VITE_SHOW_SAMPLE_SOCIAL_PROOF=

# JSON array of real, owner-supplied testimonial quotes for the Compare
# section, e.g. '[{"quote":"Cut our production time in half.","attribution":
# "A REAL CUSTOMER"}]'. The testimonial cards render only when this is
# non-empty — never fabricated, so it ships empty by default. Default: []
VITE_TESTIMONIALS_JSON=

# ---------------------------------------------------------------------------
# Worker secrets & runtime vars (Node/Workers runtime, NOT bundled into
# client JS) — see worker/env.ts for the Env type.
#
# Public vars (safe as plain vars, already set in wrangler.jsonc `vars`):
#   PARTNER_API_BASE      default: https://app.knotie-ai.pro (direct style)
#   PARTNER_API_STYLE     Two transports are supported to call the partner
#                          platform with the same pkt_ key; "direct" is the
#                          default:
#                            direct:  base https://app.knotie-ai.pro, header
#                              x-api-key: <key>, routes /api/partner/...
#                            gateway: base https://mcp.knotie-ai.pro, header
#                              Authorization: Bearer <key>, routes
#                              /api/partner-rest/tools/<tool>
#                          Set PARTNER_API_STYLE=gateway and PARTNER_API_BASE=
#                          https://mcp.knotie-ai.pro together to use the
#                          gateway routes instead.
#   EXPERIENCE_TYPE       default: media_studio
#   FREE_CREDITS          default: 300 — SINGLE SOURCE is VITE_FREE_CREDITS above;
#                          `scripts/deploy.sh` forwards it here at deploy time, so
#                          this wrangler.jsonc value is only the fallback.
#   UPSELL_AMOUNT_CENTS   default: 900 — SINGLE SOURCE is VITE_UPSELL_AMOUNT_CENTS above.
#   UPSELL_CURRENCY       default: usd — SINGLE SOURCE is VITE_UPSELL_CURRENCY above.
#   UPSELL_CREDITS        default: 500 — SINGLE SOURCE is VITE_UPSELL_CREDITS above
#                          (this is the amount actually granted server-side).
#   ONBOARD_FEATURES_JSON  default: {"showMediaStudio":true} — feature toggles applied
#                          at onboarding. Binding the experience alone leaves the
#                          studio nav OFF for the new customer; keep this unless you
#                          sell a different experience (then set its toggle, e.g.
#                          {"showWebsiteStudio":true}). Set {} to send none.
#   SITE_URL              default: https://viddescriptor.kno2gether.com
#                          (used to build the payment-link success/cancel URLs —
#                          must be an https URL on a domain you've registered in
#                          Settings → approved redirect domains on the partner
#                          platform, or checkout will fail to mint)
#
#   DISPOSABLE_EMAIL_DOMAINS  optional, comma-separated. A small built-in
#                          list of disposable-mail domains (mailinator.com,
#                          guerrillamail.com, etc.) is ALWAYS rejected at
#                          signup — this var only EXTENDS that list with your
#                          own additions. Set to the literal string 'off' to
#                          disable the check entirely, including the
#                          built-in list. Default: unset (built-in list only)
#
# Secrets (never put these in this file — copy .dev.vars.example to
# .dev.vars for local `wrangler dev`, and `wrangler secret put` in prod):
#   PARTNER_API_KEY       pkt_… key with customers:write, payments:write,
#                          payments:read scopes
#   FREE_PLAN_ID           optional plan id applied at onboarding
#   TURNSTILE_SECRET       Cloudflare Turnstile secret key, paired with
#                          VITE_TURNSTILE_SITE_KEY above. ENTIRELY OPTIONAL —
#                          when unset, /api/signup skips the Turnstile check
#                          outright (no siteverify call, no token required).
#                          Set with `wrangler secret put TURNSTILE_SECRET`
#                          (production) or add to .dev.vars (local).
# ---------------------------------------------------------------------------
