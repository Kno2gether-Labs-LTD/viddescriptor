# Copy to .dev.vars for local development (`wrangler dev` loads this automatically).
# .dev.vars is gitignored — never commit real secrets.

# Partner API key used to authenticate server-to-server calls to PARTNER_API_BASE.
PARTNER_API_KEY=

# Optional: override the free plan id used when onboarding new customers.
FREE_PLAN_ID=

# Optional: Cloudflare Turnstile secret key. When unset, /api/signup skips
# the Turnstile check entirely (no siteverify call, no token required).
# Pairs with VITE_TURNSTILE_SITE_KEY in .env.
TURNSTILE_SECRET=
